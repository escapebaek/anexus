{
  "builds": [
    {
      "src": "anhub/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9",
        "buildCommand": "bash setup.sh"
      }
    }
  ],
  "functions": {
    "anhub/wsgi.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "anhub/wsgi.py"
    }
  ]
}
